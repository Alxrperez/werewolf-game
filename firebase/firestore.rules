rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function lobbyDoc(lobbyId) { return get(/databases/$(database)/documents/lobbies/$(lobbyId)); }
    function playerDoc(lobbyId, uid) { return get(/databases/$(database)/documents/lobbies/$(lobbyId)/players/$(uid)); }
    function isHost(lobbyId) { return signedIn() && request.auth.uid == lobbyDoc(lobbyId).data.hostUid; }
    function isPlayer(lobbyId) {
      return signedIn() && exists(/databases/$(database)/documents/lobbies/$(lobbyId)/players/$(request.auth.uid));
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function lobbyPhase(lobbyId) { return lobbyDoc(lobbyId).data.phase; }

    match /meetings/{meetingId} {
      allow read, write: if signedIn();
    }

    match /lobbies/{lobbyId} {
      allow read: if isPlayer(lobbyId);
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isHost(lobbyId);

      match /players/{uid} {
        allow read: if isPlayer(lobbyId);
        allow create: if isSelf(uid);
        allow update: if isHost(lobbyId)
          || (isSelf(uid)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.displayName == resource.data.displayName
            && request.resource.data.isHost == resource.data.isHost
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.alive == resource.data.alive);
      }

      match /roleCards/{uid} {
        allow create: if isHost(lobbyId);
        allow read: if isHost(lobbyId) || isSelf(uid);
        allow update: if isHost(lobbyId)
          || (isSelf(uid)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.assignedAt == resource.data.assignedAt);
      }

      match /nightActions/{uid} {
        allow read: if isHost(lobbyId) || isSelf(uid);
        allow create, update: if isSelf(uid)
          && isPlayer(lobbyId)
          && playerDoc(lobbyId, uid).data.alive == true
          && lobbyPhase(lobbyId) == 'night';
        allow delete: if isHost(lobbyId);
      }

      match /dayVotes/{uid} {
        allow read: if isHost(lobbyId) || isSelf(uid);
        allow create, update: if isSelf(uid)
          && isPlayer(lobbyId)
          && playerDoc(lobbyId, uid).data.alive == true
          && lobbyPhase(lobbyId) == 'day';
        allow delete: if isHost(lobbyId);
      }
    }

    match /themes/{themeId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
    }
  }
}
